############################
# Core Python ignores
############################

# Virtual environments
.venv/
venv/
env/
*/.venv/
*/venv/
*/env/

# Python cache & build artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

############################
# Node / JSX ignores
############################

# Node modules
node_modules/
*/node_modules/

# Build outputs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
dist/

############################
# Project-wide structural rules
############################

# Any folder named Temp (case-sensitive)
Temp/
*/Temp/

# Anything with prefix "ignore_"
ignore_*
*/ignore_*

############################
# Asset rules (explicitly allowed)
############################

# DO NOT ignore images or creative assets
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.psd
!*.tiff
!*.bmp
!*.webp

# 3D assets
!*.obj
!*.fbx
!*.blend
!*.stl
!*.gltf
!*.glb

############################
# Misc
############################

# OS junk
.DS_Store
Thumbs.db

# IDE folders
.vscode/
.idea/
*.DotSettings.user
*.code-workspace

############################
# Unity ignores
############################

# Unity-generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/

# Unity cache & auto-generated files
MemoryCaptures/
*.pidb
*.userprefs
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.svd
*.pdb
*.mdb

# Unity build artifacts
*.apk
*.aab
*.unitypackage


# Unity cloud / collaboration
.collab/
